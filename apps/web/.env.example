# Copy to apps/web/.env.local (git-ignored). Fill only what you have; everything else falls back to demo mode.
#
# ── Browser (VITE_*) ─ shipped to every visitor, so only public values here ─────────────────────────────
VITE_PRIVY_APP_ID=
# Mapbox public token (starts with pk.), restricted to your URLs in the Mapbox console
VITE_MAPBOX_TOKEN=
VITE_MAPBOX_STYLE=mapbox://styles/shaiksameer8921/cmw3zmh4f00ql01ryhasfh3xp
# Your phone (+91...) or email, comma-separated: these accounts see /admin
VITE_ADMIN_USERS=

# ── Server only (apps/web/api) ─ NEVER prefix with VITE_. In Vercel: Settings → Environment Variables ─────
# Privy dashboard → App settings → Basic: App ID + App secret
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Supabase → Project Settings → API: URL + secret key (sb_secret_... / service_role). Run supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# ZeetoCheckout deployed on Whitechain Sepolia (see docs/SETUP.md §2)
CHECKOUT_ADDRESS=
# A NEW wallet used only to pay gas for customers (gas-free USDT). Holds WBT only. Fund it from the Whitechain faucet.
# Make one:  node -e "const{generatePrivateKey,privateKeyToAccount}=require('viem/accounts');const k=generatePrivateKey();console.log(k, privateKeyToAccount(k).address)"
RELAYER_PRIVATE_KEY=
# Relayer limits (defaults shown): min order ₹, gas-free payments per customer/day, per stall/day, daily gas budget, gas price ceiling
RELAY_MIN_INR=10
RELAY_USER_PER_DAY=25
RELAY_STALL_PER_DAY=500
RELAY_DAILY_GAS_WBT=0.5
RELAY_MAX_GWEI=5
# Optional: faster RPC (Ankr Whitechain testnet: https://rpc.ankr.com/whitechain_testnet/<key>), else the public one
WHITECHAIN_RPC=
# Google AI Studio → Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# developers.uniswap.org → API key. 1301 = Unichain Sepolia
UNISWAP_API_KEY=
UNISWAP_CHAIN_ID=1301
# Meta for Developers → WhatsApp → API setup. Verify token = any random string you also paste into the webhook form.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Your deployed URL, used in WhatsApp links (Vercel sets a default automatically)
SITE_URL=
# Same people as VITE_ADMIN_USERS, checked on the server
ADMIN_USERS=
