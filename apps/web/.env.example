# Copy to apps/web/.env.local (git-ignored). Vite only exposes VITE_* to the browser, so never put secrets here.
VITE_PRIVY_APP_ID=
# Mapbox public token (starts with pk.), restricted to your URLs in the Mapbox console
VITE_MAPBOX_TOKEN=
VITE_MAPBOX_STYLE=mapbox://styles/shaiksameer8921/cmw3zmh4f00ql01ryhasfh3xp
# Your phone (+91...) or email, comma-separated: these accounts see /admin
VITE_ADMIN_USERS=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_STREETPAY_ADDRESS=
