{
  "expo": {
    "name": "Zeeto",
    "slug": "zeeto",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0A",
    "scheme": "zeeto",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.zeeto.demo",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Show stalls near you."
      }
    },
    "android": {
      "package": "app.zeeto.demo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0A0A0A"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Take a photo of your stock to create listings.",
          "photosPermission": "Pick a photo of your stock to create listings."
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Zeeto uses the camera to scan a stall\u2019s payment QR.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
